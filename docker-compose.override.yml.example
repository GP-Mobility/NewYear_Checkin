# Example override file for local development
# Copy this to docker-compose.override.yml and modify as needed

version: '3.8'

services:
  app:
    # Override environment variables for local development
    environment:
      - NODE_ENV=development
      - DB_HOST=192.168.40.15
      - DB_USER=root
      - DB_PASSWORD=gp25095
      - DB_NAME=NYCheckin
      - DB_PORT=3800
      - QR_SECRET=local-dev-secret-key

  nginx:
    # Use HTTP-only configuration for local development
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./nginx/conf.d/http-only.conf:/etc/nginx/conf.d/default.conf:ro
      - ./nginx/logs:/var/log/nginx

